{
  "name": "uoplan-monorepo",
  "version": "1.0.0-beta.43",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm generate:if-needed && pnpm build:engine-wasm:dev:if-needed && pnpm --filter web dev",
    "build": "pnpm generate && pnpm build:engine-wasm && pnpm --filter web build",
    "deploy": "pnpm build && wrangler deploy -c apps/web/dist/uoplan/wrangler.json",
    "deploy:cf": "wrangler deploy -c apps/web/dist/uoplan/wrangler.json",
    "upload:cf": "wrangler versions upload -c apps/web/dist/uoplan/wrangler.json",
    "generate": "pnpm -r generate && pnpm build:data-proto",
    "typecheck": "pnpm wrangler types && pnpm -r typecheck && tsgo --noEmit -p scripts/tsconfig.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check:arch": "node scripts/check-architecture.ts",
    "check:i18n": "node scripts/check-i18n.ts",
    "i18n:sync": "node scripts/i18n-sync.ts",
    "sync:proto-cli": "cp packages/proto/proto/cli.proto apps/cli/proto/cli.proto",
    "build:cf": "bash scripts/cf-build.sh",
    "build:engine-wasm": "bash scripts/build-engine-wasm.sh",
    "build:engine-wasm:dev": "bash scripts/build-engine-wasm.sh --dev",
    "build:engine-native-ffi": "node scripts/build-native-engine-ffi.ts",
    "build:engine-native-ffi-android": "node scripts/build-native-engine-ffi-android.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "pnpm run -r test",
    "test:coverage": "pnpm run -r test:coverage",
    "test:ui": "pnpm --filter web test:ui",
    "coverage:rust": "pnpm --filter @uoplan/engine coverage",
    "bench": "pnpm --filter @uoplan/core bench",
    "test:watch": "pnpm --filter web test:watch",
    "lighthouse": "node scripts/lighthouse.ts",
    "prepare": "lefthook install",
    "hooks:run": "lefthook run pre-commit",
    "fallow": "fallow",
    "check:fallow": "fallow --fail-on-issues --skip health",
    "size": "pnpm --filter web size",
    "size:data": "node scripts/data-asset-sizes.ts",
    "size:routes": "node scripts/route-js-sizes.ts",
    "check:data-descriptions": "node scripts/data-asset-sizes.ts --check-description-budgets",
    "analyze": "pnpm --filter web analyze",
    "data:grades": "pnpm --filter scraper grades:convert -- --school=${npm_config_school:-uottawa} && pnpm --filter scraper scrape:grades -- --school=${npm_config_school:-uottawa} && pnpm --filter scraper enrich:schedules -- --school=${npm_config_school:-uottawa} && node scripts/fetch-data.ts && pnpm --filter scraper build:proto -- --school=${npm_config_school:-uottawa}",
    "data:build": "pnpm --filter scraper grades:convert -- --school=${npm_config_school:-uottawa} && pnpm --filter scraper scrape:grades -- --school=${npm_config_school:-uottawa} && pnpm --filter scraper build:professors -- --school=${npm_config_school:-uottawa} && pnpm --filter scraper enrich:schedules -- --school=${npm_config_school:-uottawa} && node scripts/fetch-data.ts && pnpm --filter scraper build:proto -- --school=${npm_config_school:-uottawa}",
    "data:fetch": "node scripts/fetch-data.ts",
    "build:data-proto": "node scripts/fetch-data.ts && node scripts/build-data-proto.ts",
    "cli": "cargo run --quiet --manifest-path apps/cli/Cargo.toml --",
    "generate:if-needed": "node scripts/generate-if-needed.ts",
    "build:engine-wasm:if-needed": "node scripts/engine-wasm-if-needed.ts",
    "build:engine-wasm:dev:if-needed": "node scripts/engine-wasm-if-needed.ts --dev",
    "dev:web": "pnpm generate:if-needed && pnpm build:engine-wasm:dev:if-needed && pnpm --filter web dev",
    "dev:force": "FORCE_GENERATE=1 FORCE_ENGINE_WASM=1 pnpm dev",
    "check:bulk-files": "node scripts/check-bulk-files.ts"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "7.0.0-dev.20260512.1",
    "@uoplan/domain": "workspace:*",
    "esbuild": "^0.28.0",
    "fallow": "^2.88.2",
    "lefthook": "^2.1.4",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.64.0",
    "oxlint-tsgolint": "^0.22.1",
    "pofile": "^1.1.4",
    "typescript": "^5.9.3",
    "wrangler": "^4.96.0"
  },
  "packageManager": "pnpm@10.27.0"
}
